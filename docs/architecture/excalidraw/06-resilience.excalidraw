    {
      "id": "text_40",
      "type": "text",
      "x": 80.0,
      "y": 626.0,
      "width": 860.0,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100553,
      "version": 1,
      "versionNonce": 100560,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Losing one availability zone costs nothing here: the database fails over to its\nsynchronous standby, and the general pool already holds replicas in the other two\nzones. The confidential pool spans two zones, so a ledger replica keeps serving.",
      "originalText": "Losing one availability zone costs nothing here: the database fails over to its\nsynchronous standby, and the general pool already holds replicas in the other two\nzones. The confidential pool spans two zones, so a ledger replica keeps serving.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_41",
      "type": "text",
      "x": 80.0,
      "y": 694.0,
      "width": 860.0,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100567,
      "version": 1,
      "versionNonce": 100574,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "An availability zone is a separate datacentre with independent power and cooling,\nso this is real fault isolation rather than a rack label.",
      "originalText": "An availability zone is a separate datacentre with independent power and cooling,\nso this is real fault isolation rather than a rack label.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
