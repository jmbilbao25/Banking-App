      "seed": 100945,
      "version": 1,
      "versionNonce": 100952,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Warm, not idle. Argo CD keeps the manifests identical, so failover is a promote-and-\nscale operation rather than a rebuild.",
      "originalText": "Warm, not idle. Argo CD keeps the manifests identical, so failover is a promote-and-\nscale operation rather than a rebuild.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_69",
      "type": "text",
      "x": 1180.0,
      "y": 694.0,
      "width": 860.0,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100959,
      "version": 1,
      "versionNonce": 100966,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "What this deliberately is not is active-active: two regions writing one ledger would\nneed consensus on every posting, and that latency is not worth paying here.",
      "originalText": "What this deliberately is not is active-active: two regions writing one ledger would\nneed consensus on every posting, and that latency is not worth paying here.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
