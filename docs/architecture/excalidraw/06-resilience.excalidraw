    {
      "id": "text_68",
      "type": "text",
      "x": 1180.0,
      "y": 626.0,
      "width": 860.0,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
