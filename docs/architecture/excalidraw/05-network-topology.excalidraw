      "customData": {
        "role": "text"
      },
      "text": "The isolation rule",
      "originalText": "The isolation rule",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
