    },
    {
      "id": "text_154",
      "type": "text",
      "x": 1508.0,
      "y": 212.0,
      "width": 434.0,
      "height": 178.75,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 102149,
      "version": 1,
      "versionNonce": 102156,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Follow the numbers 1 to 7: one banking\npayment, from phone to database.\n\nThe shop has its own route into its own\nspoke, its own endpoint and its own database.\n\nSolid arrow = a request. Dashed = a check.\nPurple arrows end in stored data.\n\nGrey = outside our control. No icon = our\nown code, not an Azure service.",
      "originalText": "Follow the numbers 1 to 7: one banking\npayment, from phone to database.\n\nThe shop has its own route into its own\nspoke, its own endpoint and its own database.\n\nSolid arrow = a request. Dashed = a check.\nPurple arrows end in stored data.\n\nGrey = outside our control. No icon = our\nown code, not an Azure service.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
