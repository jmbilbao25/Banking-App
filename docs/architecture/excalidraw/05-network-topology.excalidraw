      "customData": {
        "role": "zonelabel"
      },
      "text": "At a glance",
      "originalText": "At a glance",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_174",
      "type": "text",
      "x": 1508.0,
      "y": 1208.0,
      "width": 434.0,
      "height": 105.0,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 102429,
      "version": 1,
      "versionNonce": 102436,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "One region, one hub, four spokes.\nNo workload endpoint is reachable from the internet.\nTwo databases, two servers, one for each app.\nInternet-bound traffic leaves through one firewall.\nAvailability and cost: see the proposal paper. The\nearlier 99.99% and USD 16k figures are withdrawn as\nunsupported; a corrected range is given there.",
      "originalText": "One region, one hub, four spokes.\nNo workload endpoint is reachable from the internet.\nTwo databases, two servers, one for each app.\nInternet-bound traffic leaves through one firewall.\nAvailability and cost: see the proposal paper. The\nearlier 99.99% and USD 16k figures are withdrawn as\nunsupported; a corrected range is given there.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
