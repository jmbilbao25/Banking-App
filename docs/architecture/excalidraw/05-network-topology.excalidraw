      "customData": {
        "role": "zonelabel"
      },
      "text": "How to read this",
      "originalText": "How to read this",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
