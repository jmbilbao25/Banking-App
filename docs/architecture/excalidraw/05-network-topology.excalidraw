    {
      "id": "text_79",
      "type": "text",
      "x": 100.0,
      "y": 852.0,
      "width": 380.0,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 101099,
      "version": 1,
      "versionNonce": 101106,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Route tables send each spoke's internet-bound\ntraffic to the hub firewall.\n\nSpokes peer with the hub only, never with each\nother, so the two apps have no route between\nthem.\n\nEach app has its own endpoint subnet with its\nown deny-by-default rules. That, not the\nfirewall, is what keeps the two apart: Azure\nroutes endpoint traffic directly unless a\nroute-table policy says otherwise.",
      "originalText": "Route tables send each spoke's internet-bound\ntraffic to the hub firewall.\n\nSpokes peer with the hub only, never with each\nother, so the two apps have no route between\nthem.\n\nEach app has its own endpoint subnet with its\nown deny-by-default rules. That, not the\nfirewall, is what keeps the two apart: Azure\nroutes endpoint traffic directly unless a\nroute-table policy says otherwise.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
