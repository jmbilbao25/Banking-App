    {
      "id": "text_151",
      "type": "text",
      "x": 560.0,
      "y": 1307.0,
      "width": 840.0,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 102107,
      "version": 1,
      "versionNonce": 102114,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Two separate servers, one for each app: the banking app has no route, no credential and no network path to ecomdb.\nPublic network access is off on every one of these. The apps sign in with a managed identity, so there is no password to leak.",
      "originalText": "Two separate servers, one for each app: the banking app has no route, no credential and no network path to ecomdb.\nPublic network access is off on every one of these. The apps sign in with a managed identity, so there is no password to leak.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
