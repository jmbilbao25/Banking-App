      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Why we drew the boundary here",
      "originalText": "Why we drew the boundary here",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_45",
      "type": "text",
      "x": 60.0,
      "y": 726.0,
      "width": 1000.0,
      "height": 97.5,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100623,
      "version": 1,
      "versionNonce": 100630,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "EastWest selected Temenos SaaS for core banking in 2025. Their Head of Enterprise\nArchitecture describes the approach as \u201cback-to-core\u201d: keep the core standard and put\nchanges into configuration rather than custom code, so the core stays evergreen.\n\nWe followed that. Our design adds no logic to the core. The transfer service asks the\ncore to move money and treats the answer as final.",
      "originalText": "EastWest selected Temenos SaaS for core banking in 2025. Their Head of Enterprise\nArchitecture describes the approach as \u201cback-to-core\u201d: keep the core standard and put\nchanges into configuration rather than custom code, so the core stays evergreen.\n\nWe followed that. Our design adds no logic to the core. The transfer service asks the\ncore to move money and treats the answer as final.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_46",
      "type": "text",
      "x": 1110.0,
      "y": 700.0,
      "width": 560.0,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1E293B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100637,
      "version": 1,
      "versionNonce": 100644,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Also unchanged by this project",
      "originalText": "Also unchanged by this project",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_47",
      "type": "text",
      "x": 1110.0,
      "y": 726.0,
      "width": 560.0,
      "height": 81.25,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100651,
      "version": 1,
      "versionNonce": 100658,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "EastWest stores and ATMs serve the same\ncustomers and are untouched here.\n\nKomo, the digital-only bank, runs on its own\napp and is a separate piece of work.",
      "originalText": "EastWest stores and ATMs serve the same\ncustomers and are untouched here.\n\nKomo, the digital-only bank, runs on its own\napp and is a separate piece of work.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
