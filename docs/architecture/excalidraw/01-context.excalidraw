    {
      "id": "text_44",
      "type": "text",
      "x": 60.0,
      "y": 700.0,
      "width": 700.0,
      "height": 17.5,
      "angle": 0,
      "strokeColor": "#1E293B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
