    {
      "id": "text_56",
      "type": "text",
      "x": 1134.0,
      "y": 194.25,
      "width": 452.0,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#94A3B8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100777,
      "version": 1,
      "versionNonce": 100784,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "zonelabel"
      },
      "text": "What we left out, on purpose",
      "originalText": "What we left out, on purpose",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_57",
      "type": "text",
      "x": 1140.0,
      "y": 258.0,
      "width": 450.0,
      "height": 292.5,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100791,
      "version": 1,
      "versionNonce": 100798,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "No custom logic in the core. Configuration\nonly, following the bank's own back-to-core\napproach.\n\nNo second cloud. One provider and one region\nis already enough to learn properly.\n\nNo service mesh, no confidential computing,\nno image-signing pipeline. We could not have\noperated those, so we did not draw them.\n\nNo active-active across regions. If Southeast\nAsia is down, we are down. We would rather\nsay that than draw a second region we never\nsized or costed.\n\nThese are things we would read about next,\nnot things we are claiming to have built.",
      "originalText": "No custom logic in the core. Configuration\nonly, following the bank's own back-to-core\napproach.\n\nNo second cloud. One provider and one region\nis already enough to learn properly.\n\nNo service mesh, no confidential computing,\nno image-signing pipeline. We could not have\noperated those, so we did not draw them.\n\nNo active-active across regions. If Southeast\nAsia is down, we are down. We would rather\nsay that than draw a second region we never\nsized or costed.\n\nThese are things we would read about next,\nnot things we are claiming to have built.",
      "fontSize": 13,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "rectangle_58",
      "type": "rectangle",
      "x": 1120.0,
      "y": 660.0,
      "width": 480.0,
      "height": 150.0,
      "angle": 0,
      "strokeColor": "#94A3B8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": {
        "type": 3
      },
      "seed": 100805,
      "version": 1,
      "versionNonce": 100812,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "zone"
      }
    },
    {
      "id": "text_59",
      "type": "text",
      "x": 1134.0,
      "y": 634.25,
      "width": 452.0,
      "height": 18.75,
      "angle": 0,
      "strokeColor": "#94A3B8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
