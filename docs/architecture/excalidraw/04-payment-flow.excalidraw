      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "This is the only place money moves. If the transaction fails there is no outbox row, so no\nevent is ever published and the order stays PENDING with nothing debited. A half-finished\npayment is impossible by construction rather than by retry logic.",
      "originalText": "This is the only place money moves. If the transaction fails there is no outbox row, so no\nevent is ever published and the order stays PENDING with nothing debited. A half-finished\npayment is impossible by construction rather than by retry logic.",
      "fontSize": 12,
