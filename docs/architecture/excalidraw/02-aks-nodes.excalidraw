    {
      "id": "text_164",
      "type": "text",
      "x": 1735.0,
      "y": 776.0,
      "width": 320.0,
      "height": 68.75,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
