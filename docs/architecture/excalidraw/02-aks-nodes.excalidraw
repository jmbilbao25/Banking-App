      "index": null,
      "roundness": null,
      "seed": 102289,
      "version": 1,
      "versionNonce": 102296,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "A pod with no toleration is rejected by the\nscheduler, not merely discouraged. Gatekeeper\nadditionally denies any pod that has no resource\nlimit, runs as root, or references an image that\nNotation did not sign.",
      "originalText": "A pod with no toleration is rejected by the\nscheduler, not merely discouraged. Gatekeeper\nadditionally denies any pod that has no resource\nlimit, runs as root, or references an image that\nNotation did not sign.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "text_165",
      "type": "text",
      "x": 1735.0,
      "y": 856.0,
      "width": 330.0,
      "height": 55.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 102303,
      "version": 1,
      "versionNonce": 102310,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Grey chip = platform add-on \u00b7 blue = domain service\namber = confidential workload.\nUpgrades roll one node at a time and honour the PDB,\nso two replicas keep serving during an image upgrade.",
      "originalText": "Grey chip = platform add-on \u00b7 blue = domain service\namber = confidential workload.\nUpgrades roll one node at a time and honour the PDB,\nso two replicas keep serving during an image upgrade.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
