      "customData": {
        "role": "text"
      },
      "text": "The domain logic is refactored into\nservices with clear boundaries, but it\nis still the same stack the team\nalready knows how to operate.\n\nThe migration is therefore reviewable\nas a sequence of behaviour-preserving\nsteps, not as a rebuild.",
      "originalText": "The domain logic is refactored into\nservices with clear boundaries, but it\nis still the same stack the team\nalready knows how to operate.\n\nThe migration is therefore reviewable\nas a sequence of behaviour-preserving\nsteps, not as a rebuild.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
