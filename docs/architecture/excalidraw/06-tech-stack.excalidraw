      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Hub 10.0.0.0/16 with four spokes: banking 10.1, e-commerce 10.2, shared services 10.4, plus dev 10.10 and staging 10.20.\nSpokes peer only with the hub and never with each other, so neither application has a network path to the other's database.",
      "originalText": "Hub 10.0.0.0/16 with four spokes: banking 10.1, e-commerce 10.2, shared services 10.4, plus dev 10.10 and staging 10.20.\nSpokes peer only with the hub and never with each other, so neither application has a network path to the other's database.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
