      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Managed HSM holds the payment signing and certificate authority keys. It is a dedicated, always-on hardware pool billed by the hour, and one of the largest single line items in the design.\nCredentials are never environment variables, which is the specific defect of the prototype this replaces.",
      "originalText": "Managed HSM holds the payment signing and certificate authority keys. It is a dedicated, always-on hardware pool billed by the hour, and one of the largest single line items in the design.\nCredentials are never environment variables, which is the specific defect of the prototype this replaces.",
      "fontSize": 12,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
