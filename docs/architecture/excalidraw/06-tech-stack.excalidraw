      "customData": {
        "role": "text"
      },
      "text": "The pipeline builds the image, pushes\nit, deploys to the AWS dev host, curls\nthat host until it answers, and only\nthen deploys to Azure.\n\nImages are tagged with the short SHA.",
      "originalText": "The pipeline builds the image, pushes\nit, deploys to the AWS dev host, curls\nthat host until it answers, and only\nthen deploys to Azure.\n\nImages are tagged with the short SHA.",
