    {
      "id": "text_62",
      "type": "text",
      "x": 80.0,
      "y": 739.0,
      "width": 1360.0,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 100861,
