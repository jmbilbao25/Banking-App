      "customData": {
        "role": "text"
      },
      "text": "Every version here is pinned in the repository: requirements.txt, the Dockerfile, docker-compose.bank.yml and the Jenkinsfile.\nThis page describes the app as built, not the Azure design proposed on pages 2 and 5. Logos belong to their respective owners.",
      "originalText": "Every version here is pinned in the repository: requirements.txt, the Dockerfile, docker-compose.bank.yml and the Jenkinsfile.\nThis page describes the app as built, not the Azure design proposed on pages 2 and 5. Logos belong to their respective owners.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
