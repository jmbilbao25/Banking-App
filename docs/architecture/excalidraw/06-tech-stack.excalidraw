      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Bands are the cost domains used in the proposal paper, so this page and the cost model name the same things in the same order.\nThis is the target design, not the current prototype: the legacy stack was MySQL, Jenkins, AWS EC2 and Azure Container Instances, none of which appear here. Nothing on this page is deployed. Logos belong to their respective owners.",
      "originalText": "Bands are the cost domains used in the proposal paper, so this page and the cost model name the same things in the same order.\nThis is the target design, not the current prototype: the legacy stack was MySQL, Jenkins, AWS EC2 and Azure Container Instances, none of which appear here. Nothing on this page is deployed. Logos belong to their respective owners.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    }
