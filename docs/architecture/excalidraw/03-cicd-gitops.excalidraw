      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Argo CD runs inside the cluster and reaches out.\nThere is no inbound firewall rule and no service\nprincipal in GitHub with cluster rights, so a\ncompromised pipeline cannot reach production.",
      "originalText": "Argo CD runs inside the cluster and reaches out.\nThere is no inbound firewall rule and no service\nprincipal in GitHub with cluster rights, so a\ncompromised pipeline cannot reach production.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
