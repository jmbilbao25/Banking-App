      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Geo-replicated Southeast Asia + East Asia.\n\nImages are addressed by digest, never by a\nmutable tag, so 'latest' cannot drift into\nproduction the way Docker Hub did.\n\nUntagged manifests are purged after 30 days.",
      "originalText": "Geo-replicated Southeast Asia + East Asia.\n\nImages are addressed by digest, never by a\nmutable tag, so 'latest' cannot drift into\nproduction the way Docker Hub did.\n\nUntagged manifests are purged after 30 days.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
