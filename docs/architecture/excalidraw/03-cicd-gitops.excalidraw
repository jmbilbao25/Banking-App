    {
      "id": "text_94",
      "type": "text",
      "x": 538.0,
      "y": 790.0,
      "width": 668.0,
      "height": 82.5,
      "angle": 0,
      "strokeColor": "#64748B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 101309,
      "version": 1,
      "versionNonce": 101316,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "role": "text"
      },
      "text": "Every environment is a separate subscription running the same policy\nset at a smaller SKU, so a change is proven against real controls before\nit reaches prod.\n\nPromotion is a git commit, so every deploy has an author, a diff and a\nrevert that takes one merge.",
      "originalText": "Every environment is a separate subscription running the same policy\nset at a smaller SKU, so a change is proven against real controls before\nit reaches prod.\n\nPromotion is a git commit, so every deploy has an author, a diff and a\nrevert that takes one merge.",
      "fontSize": 11,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "rectangle_95",
      "type": "rectangle",
      "x": 1260.0,
      "y": 640.0,
      "width": 780.0,
      "height": 270.0,
