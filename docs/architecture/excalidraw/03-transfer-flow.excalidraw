      "customData": {
        "role": "text"
      },
      "text": "Where the boundary sits",
      "originalText": "Where the boundary sits",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
