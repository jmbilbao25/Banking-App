{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "What a Payment Can Become",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "viewBox": [
      1340,
      640
    ],
    "views": [
      {
        "id": "main-rail",
        "label": "1 \u00b7 The successful path",
        "focus": [
          "received",
          "reserved",
          "posting",
          "posted",
          "settled"
        ],
        "note": "Five ordered states. Nothing of ours is committed until the core has returned a reference."
      },
      {
        "id": "waiting",
        "label": "2 \u00b7 Waiting is not failing",
        "focus": [
          "posting",
          "awaitingCore"
        ],
        "note": "A payment with no answer from the core is neither settled nor lost; it stays in a named, non-terminal state."
      },
      {
        "id": "retry",
        "label": "3 \u00b7 Replay-safe retry",
        "focus": [
          "awaitingCore",
          "failed",
          "posting"
        ],
        "note": "The idempotency key claimed at intake is what makes a retry safe to send at all."
      },
      {
        "id": "compensation",
        "label": "4 \u00b7 Compensation, not deletion",
        "focus": [
          "settled",
          "compensating",
          "reversed"
        ],
        "note": "A settled payment is never edited away. It is reversed by a compensating entry, and both entries remain."
      },
      {
        "id": "terminal",
        "label": "5 \u00b7 The three ways out",
        "focus": [
          "expired",
          "rejected",
          "reversed"
        ],
        "note": "Retries exhausted, declined by the core, or compensated. Each exit is distinct and each is auditable."
      }
    ]
  },
