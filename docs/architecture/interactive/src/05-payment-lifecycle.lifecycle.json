  "cards": [
    {
      "dot": "emerald",
      "title": "Why the states are named",
      "items": [
        "A payment with no answer is a state, not a missing row",
        "Reserved and Settled are different facts about the same money",
        "An operator can answer 'where is my payment' from the state alone"
      ]
    },
    {
      "dot": "amber",
      "title": "Retry without paying twice",
      "items": [
        "The idempotency key is claimed before funds are reserved",
        "A resend carries the same key, so the core sees one instruction",
        "Retries are bounded; Expired is a real outcome, not a stuck row"
      ]
    },
    {
      "dot": "rose",
      "title": "What the prototype could not do",
      "items": [
        "It had no idempotency, so a replay could pay twice",
        "It used floating-point money; the target uses NUMERIC(19,4)",
        "It had a synchronous cross-domain callback, now a Service Bus read model"
      ]
    }
  ]
