    "views": [
      {
        "id": "admission",
        "label": "1 \u00b7 Admission",
        "focus": [
          "customer",
          "edge",
          "apim"
        ],
        "note": "TLS ends at Front Door. The internal gateway behind it is the Private Link origin and terminates merchant mTLS."
      },
      {
        "id": "identity",
        "label": "2 \u00b7 Who is asking",
        "focus": [
          "apim",
          "entra"
        ],
        "note": "The access token is validated before the private cluster is ever addressed."
      },
      {
        "id": "idempotency",
        "label": "3 \u00b7 Paying exactly once",
        "focus": [
          "bank",
          "redis",
          "bankdb"
        ],
        "note": "The idempotency key is claimed in Redis before funds are reserved, so a retried request cannot pay twice."
      },
      {
        "id": "handover",
        "label": "4 \u00b7 The handover",
        "focus": [
          "bank",
          "core"
        ],
        "note": "Our service never moves money. It asks the system of record to, over ExpressRoute, and that answer is final."
      },
      {
        "id": "record-and-reply",
        "label": "5 \u00b7 Record, then reply",
        "focus": [
          "bank",
          "bankdb",
          "apim",
          "edge",
          "customer"
        ],
        "note": "Nothing of ours is committed until the core has answered. The outbox row is what later drains to Service Bus."
      }
    ],
