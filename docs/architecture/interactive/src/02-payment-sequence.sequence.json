  "cards": [
    {
      "dot": "cyan",
      "title": "Where the boundary sits",
      "items": [
        "Every hop except the core is ours to operate",
        "The core's reference is final; we only record it",
        "No ledger and no settlement logic of our own"
      ]
    },
    {
      "dot": "emerald",
      "title": "Paying exactly once",
      "items": [
        "The idempotency key is claimed before funds are reserved",
        "A replay finds the key and returns the first result",
        "Ledger row and outbox row commit together, not in sequence"
      ]
    },
    {
      "dot": "amber",
      "title": "Latency, honestly",
      "items": [
        "P95 under 250 ms is a design intent, not a measurement",
        "Singapore to Manila is roughly 30 to 40 ms each way",
        "The ExpressRoute leg to the core is the longest hop"
      ]
    }
  ]
