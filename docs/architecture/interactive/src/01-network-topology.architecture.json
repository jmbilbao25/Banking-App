  "cards": [
    {
      "dot": "cyan",
      "title": "How to read this",
      "items": [
        "Bold line: one banking payment, phone to database",
        "Each frame is a virtual network",
        "Dashed: asynchronous, never a synchronous call",
        "One region: Southeast Asia, three zones"
      ]
    },
    {
      "dot": "emerald",
      "title": "Isolation the platform enforces",
      "items": [
        "Spokes peer with the hub only, never each other",
        "Two servers, two managed identities, no password",
        "Service Bus is the only link between the apps",
        "No workload endpoint is reachable from outside"
      ]
    },
    {
      "dot": "rose",
      "title": "Corrections carried from review",
      "items": [
        "App Gateway is the origin: Front Door cannot use VNet-injected APIM",
        "Database traffic is not firewall-inspected: /32 beats 0.0.0.0/0",
        "Private DNS zones resolve endpoints; the Resolver only forwards",
        "99.99% and the USD 16k run rate are withdrawn"
      ]
    }
  ]
