{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Network Topology \u2014 Hub and Spoke",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "payment-path",
        "label": "1 \u00b7 One banking payment",
        "focus": [
          "customer",
          "frontdoor",
          "appgw",
          "apim",
          "aksBank",
          "bankdb"
        ],
        "note": "One payment from phone to database. Front Door is the only inbound path from the internet."
      },
      {
        "id": "who-is-asking",
        "label": "2 \u00b7 Who is asking",
        "focus": [
          "customer",
          "frontdoor",
          "entra",
          "apim"
        ],
        "note": "Customers sign in to Entra External ID. The token is checked before the cluster sees the request."
      },
      {
        "id": "two-apps",
        "label": "3 \u00b7 Two apps, two databases",
        "focus": [
          "aksBank",
          "bankdb",
          "bus",
          "aksShop",
          "ecomdb"
        ],
        "note": "Separate servers, separate identities. Service Bus is the only link between the two applications."
      },
      {
        "id": "egress-and-core",
        "label": "4 \u00b7 Egress and the core",
        "focus": [
          "aksBank",
          "aksShop",
          "firewall",
          "core"
        ],
        "note": "Internet-bound traffic leaves through one hub firewall. The system of record is reached over ExpressRoute."
      },
      {
        "id": "not-inspected",
        "label": "5 \u00b7 What the firewall never sees",
        "focus": [
          "firewall",
          "aksBank",
          "bankdb",
          "aksShop",
          "ecomdb"
        ],
        "note": "A private endpoint installs a /32 route that beats the default route, so database traffic is not inspected."
      }
    ]
  },
