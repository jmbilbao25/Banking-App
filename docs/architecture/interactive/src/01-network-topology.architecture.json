  "cards": [
    {
      "dot": "cyan",
      "title": "Click any node",
      "items": [
        "The passport gives its kind, what it does, and the network holding it",
        "Upstream and downstream list every line, and what each one carries",
        "Zoom past 175% for the fine print; R traces a route, P plays chapters"
      ]
    },
    {
      "dot": "emerald",
      "title": "Isolation the platform enforces",
      "items": [
        "One region: Southeast Asia (Singapore), three availability zones",
        "Spokes peer with the hub only, never with each other",
        "Two servers, two managed identities, no password to leak",
        "Order totals cross Service Bus as a read model, never as a call"
      ]
    },
    {
      "dot": "rose",
      "title": "Corrections and open items",
      "items": [
        "App Gateway is the origin: Front Door cannot use VNet-injected APIM",
        "Database traffic is not firewall-inspected: /32 beats 0.0.0.0/0",
        "Private DNS zones resolve endpoints; the Resolver only forwards",
        "Only the two clusters and two databases exist as code; the rest is proposed"
      ]
    }
  ]
