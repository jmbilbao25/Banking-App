  "cards": [
    {
      "dot": "cyan",
      "title": "One record, two obligations",
      "items": [
        "Seven years, immutable, via locked time-based retention",
        "An in-country copy so a BSP examiner can read it locally",
        "A legal hold alone would not deliver the same guarantee"
      ]
    },
    {
      "dot": "emerald",
      "title": "Why the archive stays zone-redundant",
      "items": [
        "Geo-redundant storage replicates to the paired region by default",
        "That would move the audit record across a border as a side effect",
        "Zone-redundant keeps it in Singapore; the PH copy is handled separately"
      ]
    },
    {
      "dot": "rose",
      "title": "Unresolved, and stated as such",
      "items": [
        "Locked retention blocks erasure requests under RA 10173",
        "A cross-border transfer basis must be named, not gestured at",
        "The BSP outsourcing circular reference needs compliance to confirm it"
      ]
    }
  ]
