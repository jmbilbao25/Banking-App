        "id": "residency",
        "label": "4 \u00b7 Residency",
        "focus": [
          "archive",
          "phCopy",
          "compliance"
        ],
        "note": "Processing is in Singapore because Azure has no Philippine region, so a cross-border basis is required."
      },
      {
        "id": "retention",
        "label": "5 \u00b7 Seven years, locked",
        "focus": [
          "archive",
          "piiStore",
          "compliance"
        ],
        "note": "Locked time-based retention cannot be lifted, which collides with erasure rights and needs a written position."
      }
