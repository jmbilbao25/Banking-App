  "cards": [
    {
      "dot": "cyan",
      "title": "Three environments, one image",
      "items": [
        "dev 10.10.0.0/16, staging 10.20.0.0/16, production 10.1.0.0/16",
        "The same templates deploy all three; dev and staging run smaller",
        "Promotion is a registry import, so the tested bytes ship"
      ]
    },
    {
      "dot": "emerald",
      "title": "The pipeline must obey the network",
      "items": [
        "A hosted agent cannot reach a private endpoint at all",
        "The agent pool sits in the shared-services spoke with no public IP",
        "Flyway runs from there, before any pod is replaced"
      ]
    },
    {
      "dot": "amber",
      "title": "Left out on purpose",
      "items": [
        "No service mesh and no confidential computing",
        "No active-active second region: if this region is down, we are down",
        "Azure Policy starts in audit mode and moves to deny at assurance"
