  "meta": {
    "title": "Shipping Into a Private Network",
    "locale": "en",
    "quality_profile": "showcase",
    "animation": "trace",
    "views": [
      {
        "id": "happy-path",
        "label": "1 \u00b7 Commit to rollout",
        "focus": [
          "pr",
          "build",
          "gates",
          "push",
          "approve",
          "rollout"
        ],
        "note": "One reviewed change becomes one signed image, approved once, with the schema migrated before any pod is replaced."
      },
      {
        "id": "blocking-gates",
        "label": "2 \u00b7 What stops a release",
        "focus": [
          "gates",
          "blocked"
        ],
        "note": "SonarQube and Trivy are blocking, not advisory. A red gate ends the release rather than warning about it."
      },
      {
        "id": "image-custody",
        "label": "3 \u00b7 One image, imported",
        "focus": [
          "build",
          "push",
          "approve"
        ],
        "note": "Promotion between environments is a registry import, never a rebuild, so the tested bytes are the shipped bytes."
      },
      {
        "id": "inside-the-spoke",
        "label": "4 \u00b7 Agents inside a spoke",
        "focus": [
          "build",
          "rollout"
        ],
        "note": "A hosted agent cannot reach a private endpoint, so the agent pool and the schema migration both run inside the network."
      },
      {
        "id": "recovery",
        "label": "5 \u00b7 Recovery",
        "focus": [
          "rollout",
          "rollback"
        ],
        "note": "A failed health check stops the rollout before it reaches every customer, and the last good image is restored."
      }
    ],
    "viewBox": [
      1130,
      528
