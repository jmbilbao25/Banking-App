pipeline { 
  agent any 
  environment { 
    // Docker Hub Repository
    IMAGE = "jmbilbao25/qr-ecommerce-app" 
    TAG   = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'latest'}"
    
    // Target deployment EC2 IP
    EC2_IP = "3.91.174.230" // TODO: Replace with actual Ecom VM IP
    EC2_USER = "ubuntu"
  } 
  stages { 
    stage('Build Docker Image') { 
      steps { 
        sh 'docker build -t $IMAGE:$TAG -t $IMAGE:latest ./ecommerce-app' 
      } 
    } 
    stage('Push to Docker Hub') { 
      steps { 
        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
          sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
          sh 'docker push $IMAGE:$TAG'
          sh 'docker push $IMAGE:latest'
        }
      } 
    } 
 
    stage('Deploy to Dev (AWS)') { 
      steps { 
        sshagent(credentials: ['ec2-ssh-key-ecom']) {
          sh '''
            ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_IP "if [ ! -d ~/Banking-App ]; then git clone https://github.com/jmbilbao25/Banking-App.git ~/Banking-App; fi && cd ~/Banking-App && git pull && cd ecommerce-app && sudo docker compose -f docker-compose.ecom.yml pull && sudo docker compose -f docker-compose.ecom.yml up -d"
          '''
        }
      } 
    } 

    stage('Validation') {
      steps {
        script {
          echo "Waiting for Dev app to become available at http://${EC2_IP}..."
          // Retry for up to 2 minutes
          retry(12) {
            sleep(time: 10, unit: 'SECONDS')
            sh "curl -sS -f http://${EC2_IP} > /dev/null"
          }
          echo "Validation successful! Proceeding to deploy to Production."
        }
      }
    }

    stage('Deploy to Prod (Azure ACI)') {
      environment {
        AZURE_RG = "rg-azuser7669_mml.local-aafPZ"
        AZURE_LOCATION = "centralindia"
      }
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'azure-sp-credentials', passwordVariable: 'AZURE_CLIENT_SECRET', usernameVariable: 'AZURE_CLIENT_ID'),
          string(credentialsId: 'azure-tenant-id', variable: 'AZURE_TENANT_ID'),
          usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')
        ]) {
          sh 'az login --service-principal -u $AZURE_CLIENT_ID -p $AZURE_CLIENT_SECRET --tenant $AZURE_TENANT_ID'
          
          script {
            def instances = ['ecom-app-1', 'ecom-app-2']
            for (instance in instances) {
              echo "Deploying/Restarting ACI: ${instance}"
              // Check if ACI exists
              def exists = sh(script: "az container show --name ${instance} --resource-group ${AZURE_RG} --query name -o tsv || true", returnStdout: true).trim()
              
              if (exists == instance) {
                echo "${instance} exists. Restarting to pull latest image..."
                sh "az container restart --name ${instance} --resource-group ${AZURE_RG}"
              } else {
                echo "${instance} does not exist. Creating..."
                sh """
                  az container create \\
                    --resource-group ${AZURE_RG} \\
                    --name ${instance} \\
                    --image $IMAGE:$TAG \\
                    --registry-login-server index.docker.io \\
                    --registry-username \$DOCKER_USER \\
                    --registry-password "\$DOCKER_PASS" \\
                    --os-type Linux \\
                    --cpu 2 --memory 1.5 \\
                    --ports 80 \\
                    --environment-variables DB_HOST=testestste.mysql.database.azure.com DB_USER=jmbilbao25 DB_PASSWORD='@dreamCS2025' DB_NAME=ecomdb USE_SQLITE="" \\
                    --location ${AZURE_LOCATION} \\
                    --dns-name-label ${instance}
                """
              }
            }
          }
        }
      }
    }
  } 
}
