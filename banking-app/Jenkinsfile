pipeline { 
  agent any 
  environment { 
    // Docker Hub Repository
    IMAGE = "jmbilbao25/qr-banking-app" 
    TAG   = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'latest'}"
    
    // Target deployment EC2 IP
    EC2_IP = "3.84.196.154" // TODO: Replace with actual Bank VM IP
    EC2_USER = "ubuntu"
  } 
  stages { 
    stage('Build Docker Image') { 
      steps { 
        sh 'docker build -t $IMAGE:$TAG -t $IMAGE:latest ./banking-app' 
      } 
    } 
    stage('Push to Docker Hub') { 
      steps { 
        withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
          sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
          sh 'docker push $IMAGE:$TAG'
          sh 'docker push $IMAGE:latest'
        }
      } 
    } 
 
    stage('Deploy to EC2') { 
      steps { 
        sshagent(credentials: ['ec2-ssh-key']) {
          sh '''
            ssh -o StrictHostKeyChecking=no $EC2_USER@$EC2_IP << 'EOF'
              if ! command -v docker &> /dev/null; then curl -fsSL https://get.docker.com -o get-docker.sh && sudo sh get-docker.sh; fi
              if ! command -v mysql &> /dev/null; then
                sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y mysql-server
              fi
              sudo sed -i 's/^bind-address.*/bind-address = 0.0.0.0/' /etc/mysql/mysql.conf.d/mysqld.cnf
              sudo systemctl restart mysql
              sudo mysql -e "CREATE DATABASE IF NOT EXISTS bankdb;"
              sudo mysql -e "CREATE USER IF NOT EXISTS 'bankuser'@'%' IDENTIFIED BY 'devpass';"
              sudo mysql -e "ALTER USER 'bankuser'@'%' IDENTIFIED BY 'devpass';"
              sudo mysql -e "GRANT ALL PRIVILEGES ON bankdb.* TO 'bankuser'@'%';"
              sudo mysql -e "FLUSH PRIVILEGES;"
              
              if [ ! -d ~/Banking-App ]; then git clone https://github.com/jmbilbao25/Banking-App.git ~/Banking-App; fi
              cd ~/Banking-App
              git pull
              cd banking-app
              sudo docker compose -f docker-compose.bank.yml pull banking
              sudo docker compose -f docker-compose.bank.yml up -d banking
EOF
          '''
        }
      } 
    } 
  } 
}
