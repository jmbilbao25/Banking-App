# =============================================================================
# QR Payment Prototype — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# Docker Compose reads `.env` automatically from the project root.
# =============================================================================

# --- VM / Network ---
# Your VM's public IP address, with dots replaced by dashes.
# Example: if your IP is 20.51.32.10, set VM_IP=20-51-32-10
# Used by nip.io for zero-DNS hostname routing.
VM_IP=127-0-0-1

# --- MySQL ---
MYSQL_ROOT_PASSWORD=devroot
DB_NAME=bankdb
DB_USER=bankuser
DB_PASSWORD=devpass
